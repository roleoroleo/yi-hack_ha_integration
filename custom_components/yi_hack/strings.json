{
  "title": "Yi Cam with yi-hack",
  "config": {
    "step": {
      "user": {
        "title": "yi-hack configuration",
        "description": "Fill in yi-hack information",
        "data": {
          "host": "[%key:common::config_flow::data::host%]",
          "port": "[%key:common::config_flow::data::port%]",
          "username": "[%key:common::config_flow::data::username%]",
          "password": "[%key:common::config_flow::data::password%]",
          "extra_arguments": "FFMPEG extra arguments",
          "boost_speaker": "Boost the speaker volume"
        }
      },
      "zeroconf_confirm": {
        "title": "Set up {name}",
        "description": "Enter the credentials used by this yi-hack camera",
        "data": {
          "username": "[%key:common::config_flow::data::username%]",
          "password": "[%key:common::config_flow::data::password%]",
          "extra_arguments": "FFMPEG extra arguments",
          "boost_speaker": "Boost the speaker volume"
        }
      },
      "reauth_confirm": {
        "title": "Reconnect the camera",
        "description": "Update the credentials used by this yi-hack camera",
        "data": {
          "username": "[%key:common::config_flow::data::username%]",
          "password": "[%key:common::config_flow::data::password%]"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "cannot_get_mac_or_serial": "Cannot get mac address or serial number",
      "cannot_get_conf": "Cannot get configuration",
      "cannot_get_mqtt_conf": "Cannot get mqtt configuration",
      "cannot_send_ptz": "Cannot send ptz command",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "wrong_hack_version": "Unsupported hack version, please update your device",
      "not_yi-hack_device": "This is not a Yi hack camera",
      "reauth_successful": "Re-authentication was successful"
    }
  },
  "entity": {
    "button": {
      "restart": {
        "name": "Restart"
      }
    },
    "sensor": {
      "storage_free": {
        "name": "Storage free"
      },
      "uptime": {
        "name": "Uptime"
      },
      "wifi_quality": {
        "name": "Wi-Fi quality"
      }
    },
    "update": {
      "firmware": {
        "name": "Firmware"
      }
    }
  }
}
